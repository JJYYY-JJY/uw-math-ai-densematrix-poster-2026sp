+def copy_repo_snapshot(repo: Path, dst: Path) -> None:
+    def ignore(_dir: str, names: list[str]) -> set[str]:
+        ignored = set()
+        for name in names:
+            if name in REPO_SNAPSHOT_EXCLUDES or name.endswith(".pyc"):
